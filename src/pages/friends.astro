---
import PageHeader from "@/arcade/components/PageHeader.astro";
import ArcadeShell from "@/arcade/layouts/ArcadeShell.astro";
import placeholderAvatar from "@/assets/friend-placeholder.svg";
import avatarManifest from "@/data/friend-avatars.json";
import type { Friend } from "@/types/data";

// 头像由 `pnpm sync:friends` 预先拉取到仓库内，页面只引用本站资源
const avatarFiles = import.meta.glob<ImageMetadata | string>(
	"@/assets/friends/*",
	{
		eager: true,
		import: "default",
	},
);
const manifest: Record<string, { file: string }> = avatarManifest;

function localAvatar(friend: Friend) {
	const entry = manifest[friend.url];
	const asset = entry && avatarFiles[`/src/assets/friends/${entry.file}`];
	if (!asset) return placeholderAvatar.src;
	return typeof asset === "string" ? asset : asset.src;
}

const friends = Object.values(
	import.meta.glob<Friend>("@/data/friends/*.json", {
		eager: true,
		import: "default",
	}),
)
	.filter((friend) => friend?.name && friend?.url)
	.map((friend) => ({ ...friend, avatar: localAvatar(friend) }));
---

<ArcadeShell title="友链" description="连接到已登记的网络节点。">
	<section class="arcade-module-page">
		<PageHeader kicker="SYSTEM MODULE / 005" title="网络节点" description="这些友链由仓库中的多份 JSON 记录在构建期汇总，无运行时远程数据依赖。" code="005" />
		<p class="arcade-module-notice">
			想接入网络？前往
			<a href="https://github.com/MingToneFurry/blog/tree/main/src/data/friends" target="_blank" rel="noopener noreferrer">友链数据目录</a>
			提交记录。
		</p>
		{friends.length > 0 ? (
			<div class="arcade-friend-grid">
				{friends.map((friend, index) => (
					<a class="arcade-friend-card" href={friend.url} target="_blank" rel="noopener noreferrer">
						<img
							src={friend.avatar}
							loading="lazy"
							alt={`${friend.name} 的头像`}
							data-fallback={placeholderAvatar.src}
							onerror="this.onerror=null;this.src=this.dataset.fallback"
						/>
						<span>
							<strong>{friend.name}</strong>
							<p>{friend.description}</p>
						</span>
						<span aria-hidden="true">{String(index + 1).padStart(2, "0")}↗</span>
					</a>
				))}
			</div>
		) : (
			<div class="arcade-empty-state">当前没有可用网络节点。</div>
		)}
	</section>
</ArcadeShell>
